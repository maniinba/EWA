# Copy to .env and adjust. All values have sensible defaults for local dev.

# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./ewa.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg2://ewa:ewa@postgres:5432/ewa

# --- Security (CHANGE IN PRODUCTION) ---
SECRET_KEY=dev-secret-change-me-in-production-please-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- SAP for Me connector ---
SAPFORME_BASE_URL=https://api.support.sap.com
SAPFORME_TOKEN_URL=https://accounts.sap.com/oauth2/token

# --- Celery / Redis (optional) ---
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
